{
  "name": "lolmetamind-electron",
  "version": "0.2.0",
  "private": true,
  "description": "Un asistente inteligente en tiempo real para League of Legends.",
  "author": "SO->IN Soluciones informaticas",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "electron": "npx electron .",
    "electron:dev": "concurrently --kill-others \"npm run dev\" \"wait-on http://localhost:3001 && npx electron .\"",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.3.0",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "axios": "^1.12.2",
    "body-parser": "^2.2.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.6.2",
    "express": "^5.1.0",
    "fast-deep-equal": "^3.1.3",
    "framer-motion": "^11.3.19",
    "lcu-connector": "^2.1.4",
    "next": "14.2.3",
    "node-fetch": "^2.7.0",
    "react": "^18",
    "react-dom": "^18",
    "react-draggable": "^4.4.6",
    "react-icons": "^5.5.0",
    "socket.io-client": "^4.7.5",
    "tailwindcss-textshadow": "^2.1.3",
    "wait-on": "^7.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3",
    "rimraf": "^6.0.1"
  },
  "build": {
    "appId": "com.lolmetamind.coach",
    "productName": "MetaMind Coach",
    
    "files": [
      "main.js",
      "preload.js",
      "out/**/*",
      "lol-client-api.js",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    
    "extraFiles": [
      {
        "from": "python_portable",
        "to": "resources/python",
        "filter": ["**/*"]
      },
      "hf_tts_api_generator.py"
    ],
    
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "extraMetadata": {
      "description": "Incluye TTS vía API de Hugging Face para audio estable y ligero."
    }
  }
}